    "offline.text": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozimut a besoin d'Internet pour s'ouvrir. Vérifie ta connexion, puis réessaie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozimut needs the Internet to open. Check your connection, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozimut braucht das Internet zum Öffnen. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozimut necesita Internet para abrirse. Comprueba tu conexión y vuelve a intentarlo."
          }
        }
      }
