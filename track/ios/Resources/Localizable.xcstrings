    "pace.live": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live"
          }
        },
        "es": {
          "stringUnit": {
