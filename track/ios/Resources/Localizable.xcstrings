    "removed": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone a été retiré du compte. Associe-le à nouveau pour suivre une course."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone was removed from the account. Pair it again to track a run."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Telefon wurde vom Konto entfernt. Kopple es erneut, um einen Lauf zu verfolgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono se ha quitado de la cuenta. Vuelve a vincularlo para seguir una carrera."
