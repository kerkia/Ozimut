    "watch.code.help": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur ozimut.com : « Mes appareils » › « Associer une montre », puis tape ce code. Ou associe-la depuis l'app Ozimut de ton iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On ozimut.com: “My devices” › “Pair a watch”, then type this code. Or pair it from the Ozimut app on your iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf ozimut.com: „Meine Geräte“ › „Uhr koppeln“, dann diesen Code eingeben. Oder koppeln über die Ozimut-App auf deinem iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En ozimut.com: «Mis dispositivos» › «Vincular un reloj» y escribe este código. O vincúlalo desde la app Ozimut de tu iPhone."
          }
        }
      }
    },
