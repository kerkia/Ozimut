    "data.erase": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer mes données"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase my data"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Daten löschen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrar mis datos"
          }
        }
      }
    },
    "data.eraseAsk": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer tes données sur le relais de Folloz ? Plus personne ne te suivra, et tu ne suivras plus personne. Tes courses restent sur ce téléphone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase your data on Folloz's relay? Nobody will follow you any more, and you will follow nobody. Your runs stay on this phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten auf dem Relais von Folloz löschen? Niemand folgt dir mehr, und du folgst niemandem mehr. Deine Läufe bleiben auf diesem Telefon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Borrar tus datos del relé de Folloz? Nadie te seguirá ya, y tú no seguirás a nadie. Tus carreras se quedan en este teléfono."
          }
        }
      }
    },
    "data.erased": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes données ont été effacées du relais."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data was erased from the relay."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten wurden vom Relais gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos se han borrado del relé."
          }
        }
      }
    },
    "data.text": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Folloz n'a pas de compte. Son relais garde ton canal, ceux qui te suivent, ceux que tu suis et la course en cours (chiffrée). Tes courses restent sur ce téléphone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folloz keeps no account. Its relay holds your channel, the people who follow you, those you follow, and the run under way (encrypted). Your runs stay on this phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folloz hat kein Konto. Sein Relais bewahrt deinen Kanal, die Personen, die dir folgen, die, denen du folgst, und den laufenden Lauf (verschlüsselt). Deine Läufe bleiben auf diesem Telefon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Folloz no tiene cuenta. Su relé guarda tu canal, quienes te siguen, a quienes sigues y la carrera en curso (cifrada). Tus carreras se quedan en este teléfono."
          }
        }
      }
    },
