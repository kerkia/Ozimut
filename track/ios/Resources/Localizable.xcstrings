    "name.text": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est montré à ceux qui te suivent et à ceux que tu suis. Rien d'autre n'est demandé."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is shown to the people who follow you and to those you follow. Nothing else is asked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wird den Personen gezeigt, die dir folgen, und denen, denen du folgst. Sonst wird nichts abgefragt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra a quienes te siguen y a quienes sigues. No se pide nada más."
          }
        }
      }
    },
