    "zone.text": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplace la carte pour mettre la croix au centre de ta zone, et donne son rayon. Si tu en sors pendant une course, ceux qui te suivent sont prévenus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the map to put the cross at the centre of your zone, and give its radius. If you leave it during a run, the people who follow you are alerted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschiebe die Karte, bis das Kreuz in der Mitte deiner Zone liegt, und gib ihren Radius an. Verlässt du sie während eines Laufs, werden die Personen gewarnt, die dir folgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve el mapa para poner la cruz en el centro de tu zona e indica su radio. Si sales de ella durante una carrera, quienes te siguen reciben un aviso."
          }
        }
      }
    },
