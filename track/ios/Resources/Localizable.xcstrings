    "pace.err.pace": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le direct n'est pas possible : pas de course longue en cours, ou elle ne le permet pas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live is not possible: no long run is under way, or it does not allow it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live ist nicht möglich: Es ist kein langer Lauf unterwegs, oder er erlaubt es nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El directo no es posible: no hay ninguna carrera larga en curso, o no lo permite."
          }
        }
      }
    },
    "pace.err.slow": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attends quelques secondes avant de redemander."
