    "oz.linkedText": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes courses vont aussi à ce compte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your runs also go to that account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Läufe gehen auch an dieses Konto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus carreras van también a esa cuenta."
          }
        }
      }
    },
    "oz.text": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as un compte Ozimut ? Relie ce téléphone à ce compte : tes courses y vont aussi, et ceux qui t'y suivent les voient."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you have an Ozimut account? Link this phone to it: your runs also go to that account, and the people who follow you there see them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast ein Ozimut-Konto? Verbinde dieses Handy damit: Deine Läufe gehen dann auch an dieses Konto, und wer dir dort folgt, sieht sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Tienes una cuenta de Ozimut? Vincula este móvil con ella: tus carreras irán también a esa cuenta, y quienes te siguen allí las verán."
          }
        }
      }
    },
