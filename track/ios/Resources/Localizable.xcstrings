{
  "sourceLanguage": "en",
  "strings": {
    "OZ_ALERT_BATTERY": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La batterie d'une personne que tu suis est faible"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The battery of someone you follow is low"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Akku von jemandem, dem du folgst, ist schwach"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A alguien a quien sigues le queda poca batería"
          }
        }
      }
    },
    "OZ_ALERT_END": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une personne que tu suis a terminé sa course"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone you follow has ended their run"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand, dem du folgst, hat den Lauf beendet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguien a quien sigues ha terminado su carrera"
          }
        }
      }
    },
    "OZ_ALERT_HELP": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une personne que tu suis a besoin d'aide !"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone you follow needs help!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand, dem du folgst, braucht Hilfe!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Alguien a quien sigues necesita ayuda!"
          }
        }
      }
    },
    "OZ_ALERT_SILENT": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus de nouvelles d'une personne que tu suis depuis 3 minutes"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No news for 3 minutes from someone you follow"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seit 3 Minuten nichts von jemandem, dem du folgst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin noticias desde hace 3 minutos de alguien a quien sigues"
          }
        }
      }
    },
