            "value": "Directo"
          }
        }
      }
    },
    "pace.live.text": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une position par seconde, envoyée toutes les 15 s quand quelqu'un te regarde. Pour une course de quelques heures."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One position a second, sent every 15 s while someone is watching you. For a run of a few hours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Position pro Sekunde, alle 15 s gesendet, während dir jemand zuschaut. Für einen Lauf von ein paar Stunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una posición por segundo, enviada cada 15 s mientras alguien te mira. Para una carrera de unas horas."
          }
        }
      }
    },
    "pace.long": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Course longue"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long run"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Langer Lauf"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrera larga"
          }
        }
      }
    },
    "pace.long.text": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour un ultra ou un raid de plusieurs jours : le téléphone économise sa batterie. Une course longue dure 7 jours au plus. Ceux qui te suivent peuvent demander le direct un moment, sauf si ta batterie est faible."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For an ultra or a raid over several days: the phone saves its battery. A long run lasts 7 days at most. The people who follow you can ask for live for a while, unless your battery is low."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für einen Ultra oder ein Rennen über mehrere Tage: Das Handy spart Akku. Ein langer Lauf dauert höchstens 7 Tage. Wer dir folgt, kann für eine Weile Live anfragen, außer wenn dein Akku schwach ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para un ultra o un raid de varios días: el móvil ahorra batería. Una carrera larga dura 7 días como máximo. Quienes te siguen pueden pedir el directo un rato, salvo si tu batería está baja."
          }
        }
      }
    },
    "pace.longLine": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Course longue : une position toutes les %@, envoi toutes les %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long run: one position every %@, sent every %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Langer Lauf: eine Position alle %@, gesendet alle %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrera larga: una posición cada %@, envío cada %@"
          }
        }
      }
    },
    "pace.refused": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a demandé le direct : refusé pour garder ta batterie"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ asked for live: refused to save your battery"
          }
        },
        "de": {
