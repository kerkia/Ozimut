    "test.bad": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement %ld positions en 2 minutes. Vérifie dans Réglages que la localisation de Folloz est « Lorsque l'app est active » avec « Position exacte », et coupe le mode Économie d'énergie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only %ld positions in 2 minutes. In Settings, check that Folloz's location is “While Using the App” with “Precise Location”, and turn Low Power Mode off."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur %ld Positionen in 2 Minuten. Prüfe in den Einstellungen, dass der Standort von Folloz „Beim Verwenden der App“ mit „Genauer Standort“ ist, und schalte den Stromsparmodus aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo %ld posiciones en 2 minutos. En Ajustes, comprueba que la ubicación de Folloz está en «Cuando se use la app» con «Ubicación exacta», y desactiva el modo de bajo consumo."
          }
        }
      }
    },
