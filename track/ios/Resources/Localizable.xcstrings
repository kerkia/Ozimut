    "pair.intro": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur ozimut.com, dans « Suivi GPS », crée un code pour ton compte ou celui de ton enfant. Scanne son QR code, ou tape ses 8 caractères. Tes courses iront aussi à ce compte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On ozimut.com, in “GPS tracking”, make a code for your account or your child's. Scan its QR code, or type its 8 characters. Your runs then go to that account too."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle auf ozimut.com unter „GPS-Verfolgung“ einen Code für dein Konto oder das deines Kindes. Scanne seinen QR-Code oder tippe seine 8 Zeichen ein. Deine Läufe gehen dann auch an dieses Konto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En ozimut.com, en «Seguimiento GPS», crea un código para tu cuenta o la de tu hijo. Escanea su código QR o escribe sus 8 caracteres. Tus carreras irán también a esa cuenta."
          }
        }
      }
    },
