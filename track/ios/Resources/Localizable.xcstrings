    "pair.intro": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur ozimut.com, ouvre « Mes appareils » (ou « Famille ») et affiche le code d'association de ce téléphone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On ozimut.com, open “My devices” (or “Family”) and show the pairing code for this phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne auf ozimut.com „Meine Geräte“ (oder „Familie“) und lass dir den Kopplungscode für dieses Telefon anzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En ozimut.com, abre «Mis dispositivos» (o «Familia») y muestra el código de vinculación de este teléfono."
          }
        }
      }
    },
