          "stringUnit": {
            "state": "translated",
            "value": "Solo %ld posiciones en 2 minutos. En Ajustes, comprueba que la ubicación de Ozimut está en «Cuando se use la app» con «Ubicación exacta», y desactiva el modo de bajo consumo."
          }
        }
      }
    },
    "test.busy": {
      "extractionState": "manual",
      "localizations": {
