    "test.good": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parfait : %ld positions en 2 minutes. Le suivi marchera téléphone verrouillé."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfect: %ld positions in 2 minutes. Tracking will work with the phone locked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfekt: %ld Positionen in 2 Minuten. Die Verfolgung funktioniert bei gesperrtem Telefon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfecto: %ld posiciones en 2 minutos. El seguimiento funcionará con el teléfono bloqueado."
          }
        }
      }
    },
    "test.intro": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance le test, verrouille le téléphone et garde-le 2 minutes dans ta poche, comme pendant une course. Ne balaie pas l'application vers le haut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start the test, lock the phone and keep it in your pocket for 2 minutes, as during a run. Don't swipe the app away."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte den Test, sperre das Telefon und lass es 2 Minuten in der Tasche, wie bei einem Lauf. Wische die App nicht weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza la prueba, bloquea el teléfono y guárdalo 2 minutos en el bolsillo, como en una carrera. No deslices la app hacia arriba."
          }
        }
      }
    },
