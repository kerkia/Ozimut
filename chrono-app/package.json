{
  "name": "ozimut-chrono",
  "productName": "Ozimut Chrono",
  "version": "0.1.0",
  "description": "Orienteering race timing: Ozimut Chrono's screens on a computer, with a hub for the other stations and phones",
  "author": "Ozimut",
  "homepage": "https://ozimut.com",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "smoke": "node smoke.mjs",
    "smoke:unpacked": "node smoke.mjs --unpacked",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "test": "node ../tools/chrono/t_hub.mjs"
  },
  "dependencies": {
    "ws": "8.23.0"
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.ozimut.chrono",
    "productName": "Ozimut Chrono",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.mjs",
      "hub.mjs",
      "strings.mjs",
      "preload.cjs",
      "www/**"
    ],
    "extraResources": [
      {
        "from": "../site/assets",
        "to": "site/assets",
        "filter": [
          "js/**",
          "chrono/**",
          "app.css",
          "chrono.css",
          "favicon.svg",
          "icon-192.png",
          "icon-512.png",
          "apple-touch-icon.png"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "ozchrono",
        "name": "Ozimut Chrono event",
        "description": "Ozimut Chrono event",
        "role": "Editor"
      }
    ],
    "icon": "../site/assets/icon-512.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.sports",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Sports"
    },
    "electronLanguages": [
      "en-US",
      "fr",
      "de",
      "es"
    ],
    "nsis": {
      "artifactName": "Ozimut-Chrono-Setup.${ext}",
      "differentialPackage": false
    },
    "portable": {
      "artifactName": "Ozimut-Chrono-Portable.${ext}"
    },
    "dmg": {
      "artifactName": "Ozimut-Chrono.${ext}",
      "writeUpdateInfo": false
    },
    "appImage": {
      "artifactName": "Ozimut-Chrono.${ext}"
    }
  }
}
